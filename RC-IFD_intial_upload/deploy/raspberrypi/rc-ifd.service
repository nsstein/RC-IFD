# systemd *user* service: backend (link + flight logging) starts at boot, independent of the display.
# Installed by install_pi.sh to ~/.config/systemd/user/rc-ifd.service
[Unit]
Description=RC Instrument Flight Display backend (telemetry link + flight logging)
After=network.target

[Service]
ExecStart=%h/rc-ifd/.venv/bin/python %h/rc-ifd/rc_ifd.py --headless --quiet
Restart=always
RestartSec=2
# keep logging going even if the desktop session restarts
KillMode=process

[Install]
WantedBy=default.target
